---
import "../styles/global.css";
import FormattedDate from "../components/FormattedDate.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const NOTION_TOKEN = import.meta.env.NOTION_TOKEN; // lưu trong .env
const DATABASE_ID = "271529967a0c8041ad88fab4022bfdcb";

// Fetch từ Notion API
const data = await fetch(
  `https://api.notion.com/v1/databases/${DATABASE_ID}/query`,
  {
    method: "POST",
    headers: {
      Authorization: `Bearer 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`,
      "Notion-Version": "2022-06-28",
      "Content-Type": "application/json",
    },
  }
).then((res) => res.json());

const posts = (data.results || []).map(
  (page: { properties: any; id: any; created_time: any }) => {
    const props = page.properties;
    return {
      id: page.id,
      slug: `/${page.id}`, // bạn có thể tạo slug riêng
      title: props.Name?.title?.[0]?.plain_text || "No title",
      intro: props.Outline?.rich_text?.[0]?.plain_text || "",
      content: props.Content?.rich_text?.[0]?.plain_text || "",
      tags: (props.Tags?.multi_select || []).map((t: { name: any }) => t.name),
      createdAt: page.created_time,
    };
  }
);

// Hàm tính thời gian đọc
const calculateReadTime = (intro: string, content: string) => {
  const words = intro.split(" ").length + content.split(" ").length;
  return Math.ceil(words / 200);
};

const siteUrl = "https://yourdomain.com";
const seo = {
  title: "Novu",
  description: "hello",
  url: siteUrl,
  image: `${siteUrl}/og-default.png`,
  imageAlt: "Novu",
  lang: "vi",
};
---

<BaseLayout seo={seo}>
  <main class="container mx-auto px-4 py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold mb-4">Novu Blog</h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Discover insights, stories, and ideas from our team
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        posts.map((post: any) => (
          <article class="blog-card bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300">
            <a href={post.slug}>
              <div class="h-48 bg-gradient-to-r from-[#f4953f] to-[#f6bc88]" />
              <div class="p-6 flex flex-col justify-between h-full">
                <div>
                  <span class="text-sm text-gray-500">
                    <FormattedDate date={new Date(post.createdAt)} />
                    {" • "}
                    {calculateReadTime(post.intro, post.content)} min read
                  </span>
                  <h3 class="text-xl font-semibold mt-2 mb-3">{post.title}</h3>
                  <p class="text-gray-700 mb-4 prose max-w-full">
                    {post.intro}
                  </p>
                  <div class="flex flex-wrap gap-2 mt-2">
                    {post.tags.map((tag: any) => (
                      <span class="text-xs bg-gray-200 px-2 py-1 rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
                <a
                  href={post.slug}
                  class="read-more-btn mt-auto inline-block px-4 py-2 bg-[#f4953f] text-white rounded-md hover:bg-[#f67c2e] transition-colors duration-200"
                >
                  Read More
                </a>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
