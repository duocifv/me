---
import trending from "../data/trending.json";
import bychatgpt from "../data/bychatgpt.json";
import "../styles/gpts.css";
import FormattedDate from "../components/FormattedDate.astro";

const NOTION_TOKEN = import.meta.env.NOTION_TOKEN; // lưu trong .env
const DATABASE_ID = "271529967a0c8041ad88fab4022bfdcb";

// Fetch từ Notion API
const data = await fetch(
  `https://api.notion.com/v1/databases/${DATABASE_ID}/query`,
  {
    method: "POST",
    headers: {
      Authorization: `Bearer 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`,
      "Notion-Version": "2022-06-28",
      "Content-Type": "application/json",
    },
  }
).then((res) => res.json());

const posts = (data.results || []).map(
  (page: { properties: any; id: any; created_time: any }) => {
    const props = page.properties;
    return {
      id: page.id,
      slug: `/${page.id}`, // bạn có thể tạo slug riêng
      title: props.Name?.title?.[0]?.plain_text || "No title",
      intro: props.Outline?.rich_text?.[0]?.plain_text || "",
      content: props.Content?.rich_text?.[0]?.plain_text || "",
      tags: (props.Tags?.multi_select || []).map((t: { name: any }) => t.name),
      createdAt: page.created_time,
    };
  }
);

// Hàm tính thời gian đọc
const calculateReadTime = (intro: string, content: string) => {
  const words = intro.split(" ").length + content.split(" ").length;
  return Math.ceil(words / 200);
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tytytu Explore</title>
  </head>
  <body>
    <main class="page-container">
      <!-- Header -->
      <div class="header">
        <h1>tytytu</h1>
        <p>
          Discover and create custom versions of ChatGPT that combine
          instructions, extra knowledge, and any combination of skills.
        </p>
      </div>

      <!-- Search bar -->
      <div class="search">
        <input type="text" placeholder="Search tytytu" />
      </div>

      <!-- Tabs -->
      <nav class="tabs">
        <a href="#" class="active">Featured</a>
        <a href="#">Writing</a>
        <a href="#">Productivity</a>
        <a href="#">Research & Analysis</a>
        <a href="#">Education</a>
        <a href="#">Lifestyle</a>
        <a href="#">Programming</a>
      </nav>

      <!-- Featured -->
      <section class="section">
        <h2>Featured</h2>
        <p class="subtitle">Curated top picks from this week</p>

        <div class="card-grid grid-2">
          {/* Cột trái: Card lớn */}
          <div class="mag-left">
            {
              posts.slice(0, 1).map((post: any) => (
                <div class="mag-card mag-large">
                  <a href={post.slug} class="mag-link-vertical">
                    <img
                      src="https://picsum.photos/600/400?random=1"
                      alt={post.title}
                    />
                    <div class="mag-content">
                      <h3>{post.title}</h3>
                      <p>{post.intro}</p>
                      <span class="mag-meta">
                        <FormattedDate date={new Date(post.createdAt)} /> •{" "}
                        {calculateReadTime(post.intro, post.content)} min read
                      </span>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>

          {/* Cột phải: 4 card nhỏ giống phong cách trending */}
          <div class="mag-right">
            {
              posts.slice(1, 4).map((post: any, i: number) => (
                <div class="mag-card mag-small">
                  <a href={post.slug} class="mag-link">
                    <div class="mag-thumb">
                      <img
                        src={`https://picsum.photos/100/100?random=${i + 2}`}
                        alt={post.title}
                      />
                    </div>
                    <div class="mag-content">
                      <h3 class="mag-sub">{post.title}</h3>
                      <p class="mag-desc">{post.intro}</p>
                      <span class="mag-meta">
                        <FormattedDate date={new Date(post.createdAt)} /> •{" "}
                        {calculateReadTime(post.intro, post.content)} min read
                      </span>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- Trending -->
      <section class="section">
        <h2>Trending</h2>
        <p class="subtitle">Most popular GPTs by our community</p>
        <div class="card-grid grid-2">
          {
            trending.map((item) => (
              <div class="card flex">
                <div class="rank">{item.rank}</div>
                <img src={item.img} alt={item.title} />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                  <span>By {item.author}</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="see-more"><button>See more</button></div>
      </section>

      <!-- By ChatGPT -->
      <section class="section">
        <h2>By ChatGPT</h2>
        <p class="subtitle">GPTs created by the ChatGPT team</p>
        <div class="card-grid grid-2">
          {
            bychatgpt.map((item) => (
              <div class="card flex">
                <div class="rank">{item.rank}</div>
                <img src={item.img} alt={item.title} />
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                  <span>By {item.author}</span>
                </div>
              </div>
            ))
          }
        </div>
        <div class="see-more"><button>See more</button></div>
      </section>
    </main>
    <script>
      const tabs = document.querySelectorAll(".tabs a");
      tabs.forEach((tab) => {
        tab.addEventListener("click", (e) => {
          e.preventDefault();
          tabs.forEach((t) => t.classList.remove("active"));
          tab.classList.add("active");
        });
      });
    </script>
  </body>
</html>
